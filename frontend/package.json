{
  "name": "kross-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "admin-web"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:admin": "npm run dev -w admin-web",
    "build": "npm run build -w web && npm run build -w admin-web",
    "typecheck": "npm run typecheck -w web && npm run typecheck -w admin-web",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
