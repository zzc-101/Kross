{
  "name": "kross-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:admin": "pnpm --filter admin-web dev",
    "build": "pnpm --filter web build && pnpm --filter admin-web build",
    "typecheck": "pnpm --filter web typecheck && pnpm --filter admin-web typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
