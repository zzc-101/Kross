                    "target": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "plan"
                            },
                            "planDigest": {
                              "type": "string",
                              "minLength": 64,
                              "maxLength": 64,
                              "pattern": "^[a-f0-9]{64}$"
                            }
                          },
                          "required": [
                            "type",
                            "planDigest"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "tool"
                            },
                            "toolCallId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "toolName": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 240,
                              "pattern": "\\S"
                            },
                            "argumentsHash": {
                              "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/event/anyOf/6/properties/approval/properties/target/anyOf/0/properties/planDigest"
                            }
                          },
                          "required": [
                            "type",
                            "toolCallId",
                            "toolName",
                            "argumentsHash"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "external_action"
                            },
                            "actionType": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 240,
                              "pattern": "\\S"
                            },
                            "idempotencyKey": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200,
                              "pattern": "^[\\x21-\\x7e]+$"
                            },
                            "argumentsHash": {
                              "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/event/anyOf/6/properties/approval/properties/target/anyOf/0/properties/planDigest"
                            }
                          },
                          "required": [
                            "type",
                            "actionType",
                            "idempotencyKey",
                            "argumentsHash"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "elevated_access"
                            },
                            "capability": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 240,
                              "pattern": "\\S"
                            },
                            "argumentsHash": {
                              "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/event/anyOf/6/properties/approval/properties/target/anyOf/0/properties/planDigest"
                            }
                          },
                          "required": [
                            "type",
                            "capability",
                            "argumentsHash"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "requestedAt": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/timestamp"
                    },
                    "expiresAt": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/timestamp"
                    },
                    "status": {
                      "type": "string",
                      "const": "pending"
                    }
                  },
                  "required": [
                    "id",
                    "organizationId",
                    "projectId",
                    "taskId",
                    "runId",
                    "scope",
                    "riskLevel",
                    "actionPreview",
                    "target",
                    "requestedAt",
                    "status"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "type",
                "approval"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "run.checkpoint_updated"
                },
                "checkpointKey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "sha256": {
                  "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/event/anyOf/6/properties/approval/properties/target/anyOf/0/properties/planDigest"
                },
                "sizeBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "completedThroughSeq": {
                  "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/seq"
                }
              },
              "required": [
                "type",
                "checkpointKey",
                "sha256",
                "sizeBytes",
                "completedThroughSeq"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "run.terminal"
                },
                "terminal": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "const": "completed"
                        },
                        "summary": {
                          "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/event/anyOf/1/properties/message"
                        },
                        "finalMessageId": {
                          "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/runId"
                        },
                        "finishedAt": {
                          "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/timestamp"
                        }
                      },
                      "required": [
                        "status",
                        "summary",
                        "finishedAt"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "const": "failed"
                        },
                        "summary": {
                          "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/event/anyOf/1/properties/message"
                        },
                        "finalMessageId": {
                          "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/runId"
                        },
                        "failure": {
                          "type": "object",
                          "properties": {
                            "code": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 120,
                              "pattern": "^[A-Z][A-Z0-9_]*$"
                            },
                            "summary": {
                              "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/event/anyOf/1/properties/message"
                            },
                            "retryable": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "code",
                            "summary",
                            "retryable"
                          ],
                          "additionalProperties": false
                        },
                        "finishedAt": {
                          "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/timestamp"
                        }
                      },
                      "required": [
                        "status",
                        "summary",
                        "failure",
                        "finishedAt"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "const": "cancelled"
                        },
                        "summary": {
                          "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/event/anyOf/1/properties/message"
                        },
                        "finalMessageId": {
                          "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/runId"
                        },
                        "finishedAt": {
                          "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/timestamp"
                        }
                      },
                      "required": [
                        "status",
                        "summary",
                        "finishedAt"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "type",
                "terminal"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "protocolVersion",
        "runId",
        "generation",
        "seq",
        "timestamp",
        "event"
      ],
      "additionalProperties": false
    }
  }
}
