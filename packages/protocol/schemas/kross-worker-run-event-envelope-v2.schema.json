                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240,
                      "pattern": "\\S"
                    },
                    "displayName": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/event/anyOf/3/properties/message/properties/content/items/anyOf/1/properties/label"
                    },
                    "status": {
                      "type": "string",
                      "const": "running"
                    },
                    "risk": {
                      "type": "string",
                      "enum": [
                        "low",
                        "medium",
                        "high",
                        "critical"
                      ]
                    },
                    "summary": {
                      "type": "string",
                      "maxLength": 4000
                    },
                    "startedAt": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/timestamp"
                    },
                    "finishedAt": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/timestamp"
                    },
                    "durationMs": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "toolCallId",
                    "name",
                    "displayName",
                    "status",
                    "risk",
                    "startedAt"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "type",
                "tool"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "run.tool_completed"
                },
                "tool": {
                  "type": "object",
                  "properties": {
                    "toolCallId": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/runId"
                    },
                    "name": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/event/anyOf/4/properties/tool/properties/name"
                    },
                    "displayName": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/event/anyOf/3/properties/message/properties/content/items/anyOf/1/properties/label"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "completed",
                        "failed",
                        "denied",
                        "cancelled"
                      ]
                    },
                    "risk": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/event/anyOf/4/properties/tool/properties/risk"
                    },
                    "summary": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/event/anyOf/4/properties/tool/properties/summary"
                    },
                    "startedAt": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/timestamp"
                    },
                    "finishedAt": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/timestamp"
                    },
                    "durationMs": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/event/anyOf/4/properties/tool/properties/durationMs"
                    }
                  },
                  "required": [
                    "toolCallId",
                    "name",
                    "displayName",
                    "status",
                    "risk",
                    "startedAt",
                    "finishedAt"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "type",
                "tool"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "run.approval_requested"
                },
