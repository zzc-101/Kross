{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/zzc-101/Kross/main/packages/protocol/schemas/kross-worker-run-event-envelope-v2.schema.json",
  "title": "KrossWorkerRunEventEnvelopeV2",
  "x-kross-protocol-version": 2,
  "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2",
  "definitions": {
    "KrossWorkerRunEventEnvelopeV2": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "number",
          "const": 2
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "generation": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 2147483647
        },
        "seq": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "event": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "run.started"
                },
                "startedAt": {
                  "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/timestamp"
                }
              },
              "required": [
                "type",
                "startedAt"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "run.progress"
                },
                "phase": {
                  "type": "string",
                  "enum": [
                    "planning",
                    "gathering_sources",
                    "executing",
                    "using_tool",
                    "waiting_for_approval",
                    "creating_artifact",
                    "verifying",
                    "finalizing"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000,
                  "pattern": "\\S"
                },
                "stepId": {
                  "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/runId"
                },
                "completedUnits": {
                  "type": "integer",
                  "minimum": 0
                },
                "totalUnits": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "percent": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "type",
                "phase",
                "message"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "run.message_delta"
                },
                "messageId": {
                  "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/runId"
                },
                "index": {
                  "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/seq"
                },
                "delta": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192,
                  "pattern": "\\S"
                }
              },
              "required": [
                "type",
                "messageId",
                "index",
                "delta"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "run.message_final"
                },
                "message": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/runId"
                    },
                    "organizationId": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/runId"
                    },
                    "projectId": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/runId"
                    },
                    "taskId": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/runId"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "user",
                        "agent",
                        "system"
                      ]
                    },
                    "content": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "const": "text"
                              },
                              "text": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 32768,
                                "pattern": "\\S"
                              }
                            },
                            "required": [
                              "type",
                              "text"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "const": "source_reference"
                              },
                              "sourceId": {
                                "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/runId"
                              },
                              "label": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 500,
                                "pattern": "\\S"
                              }
                            },
                            "required": [
                              "type",
                              "sourceId"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "const": "artifact_reference"
                              },
                              "artifactId": {
                                "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/runId"
                              },
                              "label": {
                                "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/event/anyOf/3/properties/message/properties/content/items/anyOf/1/properties/label"
                              }
                            },
                            "required": [
                              "type",
                              "artifactId"
                            ],
                            "additionalProperties": false
                          }
                        ]
