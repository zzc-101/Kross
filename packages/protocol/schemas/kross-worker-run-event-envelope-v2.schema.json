                      "minItems": 1,
                      "maxItems": 20
                    },
                    "createdBy": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/runId"
                    },
                    "createdAt": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/timestamp"
                    }
                  },
                  "required": [
                    "id",
                    "organizationId",
                    "projectId",
                    "taskId",
                    "role",
                    "content",
                    "createdAt"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "type",
                "message"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
