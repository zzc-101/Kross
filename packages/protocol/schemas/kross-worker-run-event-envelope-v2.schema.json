                  "type": "object",
                  "properties": {
                    "id": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/runId"
                    },
                    "organizationId": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/runId"
                    },
                    "projectId": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/runId"
                    },
                    "taskId": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/runId"
                    },
                    "runId": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/runId"
                    },
                    "scope": {
                      "type": "string",
                      "enum": [
                        "run",
                        "organization"
                      ]
                    },
                    "riskLevel": {
                      "type": "string",
                      "enum": [
                        "low",
                        "medium",
                        "high",
                        "critical"
                      ]
                    },
                    "actionPreview": {
                      "$ref": "#/definitions/KrossWorkerRunEventEnvelopeV2/properties/event/anyOf/3/properties/message/properties/content/items/anyOf/0/properties/text"
