{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/zzc-101/Kross/main/packages/protocol/schemas/kross-run-spec-v2.schema.json",
  "title": "KrossRunSpecV2",
  "x-kross-protocol-version": 2,
  "$ref": "#/definitions/KrossRunSpecV2",
  "definitions": {
    "KrossRunSpecV2": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "number",
          "const": 2
        },
        "organizationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "projectId": {
          "$ref": "#/definitions/KrossRunSpecV2/properties/organizationId"
        },
        "taskId": {
          "$ref": "#/definitions/KrossRunSpecV2/properties/organizationId"
        },
        "runId": {
          "$ref": "#/definitions/KrossRunSpecV2/properties/organizationId"
        },
        "generation": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 2147483647
        },
        "leaseId": {
          "$ref": "#/definitions/KrossRunSpecV2/properties/organizationId"
        },
        "leaseExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "issuedAt": {
          "$ref": "#/definitions/KrossRunSpecV2/properties/leaseExpiresAt"
        },
        "task": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "general",
                "research",
                "document",
                "data",
                "coding",
                "automation"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            },
            "objective": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768,
              "pattern": "\\S"
            },
            "constraints": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/KrossRunSpecV2/properties/task/properties/objective"
              },
              "maxItems": 50
            },
            "acceptanceCriteria": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/KrossRunSpecV2/properties/task/properties/objective"
              },
              "maxItems": 50
            },
            "messages": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/KrossRunSpecV2/properties/organizationId"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "user",
                      "agent",
                      "system"
                    ]
                  },
                  "text": {
                    "$ref": "#/definitions/KrossRunSpecV2/properties/task/properties/objective"
                  },
                  "createdAt": {
                    "$ref": "#/definitions/KrossRunSpecV2/properties/leaseExpiresAt"
                  }
                },
                "required": [
                  "id",
                  "role",
                  "text",
                  "createdAt"
                ],
                "additionalProperties": false
              },
              "maxItems": 500
            }
          },
          "required": [
            "type",
            "title",
            "objective",
            "constraints",
            "acceptanceCriteria",
            "messages"
          ],
          "additionalProperties": false
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/KrossRunSpecV2/properties/organizationId"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "upload",
                  "url",
                  "repository",
                  "connector",
                  "generated"
                ]
              },
              "displayName": {
                "$ref": "#/definitions/KrossRunSpecV2/properties/task/properties/title"
              },
              "fileName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]*$"
              },
              "mimeType": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[!#$&^_.+A-Za-z0-9-]+\\/[!#$&^_.+A-Za-z0-9-]+$"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "sha256": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              },
              "downloadUrl": {
                "type": "string",
                "format": "uri",
                "maxLength": 4096,
                "pattern": "^https?:\\/\\/"
              },
              "downloadHeaders": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
                    },
                    "value": {
                      "type": "string",
                      "maxLength": 2048,
                      "pattern": "^[^\\r\\n]*$"
                    }
                  },
                  "required": [
                    "name",
                    "value"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 32
              },
              "expiresAt": {
                "$ref": "#/definitions/KrossRunSpecV2/properties/leaseExpiresAt"
              }
            },
            "required": [
              "id",
              "kind",
              "displayName",
              "fileName",
              "mimeType",
              "sizeBytes",
              "sha256",
              "downloadUrl",
              "downloadHeaders",
              "expiresAt"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "repository": {
          "type": "object",
          "properties": {
            "gitUrl": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "credentialHandle": {
              "$ref": "#/definitions/KrossRunSpecV2/properties/organizationId"
            }
          },
          "required": [
            "gitUrl",
            "revision"
          ],
          "additionalProperties": false
        },
        "model": {
          "type": "object",
          "properties": {
            "requestedModelProfileId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "\\S"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "\\S"
            },
            "baseUrlOrigin": {
              "$ref": "#/definitions/KrossRunSpecV2/properties/sources/items/properties/downloadUrl"
            },
            "credentialHandle": {
              "$ref": "#/definitions/KrossRunSpecV2/properties/organizationId"
            }
          },
          "required": [
            "provider",
            "model",
            "credentialHandle"
          ],
          "additionalProperties": false
        },
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "plan"
          ]
        },
        "executionProfile": {
          "type": "string",
          "const": "work"
        },
        "policy": {
          "type": "object",
          "properties": {
            "permissionPolicy": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "allowNetworkAccess": {
                  "type": "boolean"
                },
                "allowRepositoryWrite": {
                  "type": "boolean"
                },
                "allowedConnectorScopes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240,
                    "pattern": "\\S"
                  },
                  "maxItems": 100
                },
                "approvalPolicy": {
                  "type": "object",
                  "properties": {
                    "requirePlanApproval": {
                      "type": "boolean"
                    },
                    "requireExternalActionApproval": {
                      "type": "boolean"
                    },
                    "minimumToolRiskRequiringApproval": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "low",
                            "medium",
                            "high",
                            "critical"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "allowAdminOrganizationHighRiskApproval": {
                      "type": "boolean"
                    },
                    "allowMemberHighRiskApproval": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "requirePlanApproval",
                    "requireExternalActionApproval",
                    "minimumToolRiskRequiringApproval",
                    "allowAdminOrganizationHighRiskApproval",
                    "allowMemberHighRiskApproval"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "version",
                "allowNetworkAccess",
                "allowRepositoryWrite",
                "allowedConnectorScopes",
                "approvalPolicy"
              ],
              "additionalProperties": false
            },
            "allowedToolNames": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "maxItems": 100
            },
            "connectorInstallationIds": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/KrossRunSpecV2/properties/organizationId"
              },
              "maxItems": 100
            },
            "externalActions": {
              "type": "string",
              "enum": [
                "require_approval",
                "draft_only",
                "deny"
              ]
            },
            "networkAccess": {
              "type": "string",
              "enum": [
                "restricted",
                "connector_proxy_only",
                "disabled"
              ]
            }
          },
          "required": [
            "permissionPolicy",
            "allowedToolNames",
            "connectorInstallationIds",
            "externalActions",
            "networkAccess"
          ],
          "additionalProperties": false
        },
        "resourceLimits": {
          "type": "object",
          "properties": {
            "cpuMillis": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 64000
            },
            "memoryBytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxPids": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 1000000
            },
            "diskBytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxDurationMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 86400000
            },
            "maxSourceBytes": {
              "$ref": "#/definitions/KrossRunSpecV2/properties/sources/items/properties/sizeBytes"
            },
            "maxArtifactBytes": {
              "$ref": "#/definitions/KrossRunSpecV2/properties/sources/items/properties/sizeBytes"
            },
            "maxEventPayloadBytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 1048576
            },
            "maxTokens": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "maxCostUsd": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "cpuMillis",
            "memoryBytes",
            "maxPids",
            "diskBytes",
            "maxDurationMs",
            "maxSourceBytes",
            "maxArtifactBytes",
            "maxEventPayloadBytes"
          ],
          "additionalProperties": false
        },
        "workspace": {
          "type": "object",
          "properties": {
            "root": {
              "type": "string",
              "pattern": "^\\/work$",
              "maxLength": 4096
            },
            "inputDirectory": {
              "type": "string",
              "pattern": "^\\/work\\/input(?:\\/(?!\\.{1,2}(?:\\/|$))[^/\\u0000]+)*$",
              "maxLength": 4096
            },
            "outputDirectory": {
              "type": "string",
              "pattern": "^\\/work\\/output(?:\\/(?!\\.{1,2}(?:\\/|$))[^/\\u0000]+)*$",
              "maxLength": 4096
            },
            "checkpointDirectory": {
              "type": "string",
              "pattern": "^\\/work\\/checkpoint(?:\\/(?!\\.{1,2}(?:\\/|$))[^/\\u0000]+)*$",
              "maxLength": 4096
            },
            "repositoryDirectory": {
              "type": "string",
              "pattern": "^\\/work\\/repository(?:\\/(?!\\.{1,2}(?:\\/|$))[^/\\u0000]+)*$",
              "maxLength": 4096
            }
          },
          "required": [
            "root",
            "inputDirectory",
            "outputDirectory",
            "checkpointDirectory"
          ],
          "additionalProperties": false
        },
        "resumeCheckpointKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "protocolVersion",
        "organizationId",
        "projectId",
        "taskId",
        "runId",
        "generation",
        "leaseId",
        "leaseExpiresAt",
        "issuedAt",
        "task",
        "sources",
        "model",
        "mode",
        "executionProfile",
        "policy",
        "resourceLimits",
        "workspace"
      ],
      "additionalProperties": false
    }
  }
}
