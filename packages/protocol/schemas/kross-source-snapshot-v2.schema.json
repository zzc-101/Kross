            },
            "previewAvailable": {
              "$ref": "#/definitions/KrossSourceSnapshotV2/anyOf/0/properties/previewAvailable"
            },
            "diagnostic": {
              "$ref": "#/definitions/KrossSourceSnapshotV2/anyOf/0/properties/diagnostic"
            },
            "scope": {
              "type": "string",
              "const": "task"
            },
            "taskId": {
              "$ref": "#/definitions/KrossSourceSnapshotV2/anyOf/0/properties/id"
            },
            "status": {
              "type": "string",
              "const": "ready"
            },
            "sizeBytes": {
              "$ref": "#/definitions/KrossSourceSnapshotV2/anyOf/0/properties/sizeBytes"
            },
            "sha256": {
              "$ref": "#/definitions/KrossSourceSnapshotV2/anyOf/0/properties/sha256"
            }
          },
          "required": [
            "id",
            "organizationId",
            "projectId",
            "kind",
            "displayName",
            "createdBy",
            "createdAt",
            "origin",
            "parsedTextAvailable",
            "previewAvailable",
            "scope",
            "taskId",
            "status",
