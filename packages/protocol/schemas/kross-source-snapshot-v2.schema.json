{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/zzc-101/Kross/main/packages/protocol/schemas/kross-source-snapshot-v2.schema.json",
  "title": "KrossSourceSnapshotV2",
  "x-kross-protocol-version": 2,
  "$ref": "#/definitions/KrossSourceSnapshotV2",
  "definitions": {
    "KrossSourceSnapshotV2": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "organizationId": {
              "$ref": "#/definitions/KrossSourceSnapshotV2/anyOf/0/properties/id"
            },
            "projectId": {
              "$ref": "#/definitions/KrossSourceSnapshotV2/anyOf/0/properties/id"
            },
            "kind": {
              "type": "string",
              "enum": [
                "upload",
                "url",
                "repository",
                "connector",
                "generated"
              ]
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            },
            "mimeType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[!#$&^_.+A-Za-z0-9-]+\\/[!#$&^_.+A-Za-z0-9-]+$"
            },
            "previousSourceId": {
              "$ref": "#/definitions/KrossSourceSnapshotV2/anyOf/0/properties/id"
            },
            "createdBy": {
              "$ref": "#/definitions/KrossSourceSnapshotV2/anyOf/0/properties/id"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "origin": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "upload"
                    },
                    "originalFileName": {
                      "$ref": "#/definitions/KrossSourceSnapshotV2/anyOf/0/properties/displayName"
                    }
                  },
                  "required": [
                    "kind",
                    "originalFileName"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "url"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "maxLength": 4096,
                      "pattern": "^https?:\\/\\/"
                    }
                  },
                  "required": [
                    "kind",
                    "url"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "repository"
                    },
                    "gitUrl": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "\\S"
                    },
                    "revision": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240,
                      "pattern": "\\S"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "kind",
                    "gitUrl"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "connector"
                    },
                    "installationId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "externalResourceId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "kind",
                    "installationId",
                    "externalResourceId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "generated"
                    },
                    "runId": {
                      "$ref": "#/definitions/KrossSourceSnapshotV2/anyOf/0/properties/id"
                    },
                    "artifactId": {
                      "$ref": "#/definitions/KrossSourceSnapshotV2/anyOf/0/properties/id"
                    }
                  },
                  "required": [
                    "kind",
                    "runId"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "parsedTextAvailable": {
              "type": "boolean"
            },
            "previewAvailable": {
              "type": "boolean"
            },
            "diagnostic": {
              "type": "string",
              "maxLength": 4000
            },
            "scope": {
              "type": "string",
              "const": "project"
            },
            "status": {
              "type": "string",
              "const": "ready"
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "organizationId",
            "projectId",
            "kind",
            "displayName",
            "createdBy",
            "createdAt",
            "origin",
            "parsedTextAvailable",
            "previewAvailable",
            "scope",
            "status",
            "sizeBytes",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
