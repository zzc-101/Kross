            },
            "sourceIds": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/KrossArtifactSnapshotV2/anyOf/0/properties/id"
              },
              "maxItems": 100
            },
            "previewAvailable": {
              "type": "boolean"
            },
            "downloadPath": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^\\/api\\/v2\\/"
            },
            "diagnostic": {
              "type": "string",
              "maxLength": 4000
            },
            "status": {
              "type": "string",
              "const": "pending"
            },
            "mimeType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[!#$&^_.+A-Za-z0-9-]+\\/[!#$&^_.+A-Za-z0-9-]+$"
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "organizationId",
            "projectId",
            "taskId",
            "runId",
            "kind",
            "displayName",
            "createdAt",
