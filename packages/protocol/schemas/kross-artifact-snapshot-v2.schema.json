            },
            "runId": {
              "$ref": "#/definitions/KrossArtifactSnapshotV2/anyOf/0/properties/id"
            },
            "kind": {
              "type": "string",
              "enum": [
                "document",
                "spreadsheet",
                "presentation",
                "image",
                "data",
                "code",
                "archive",
                "other"
              ]
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            },
            "parentArtifactId": {
              "$ref": "#/definitions/KrossArtifactSnapshotV2/anyOf/0/properties/id"
            },
            "createdAt": {
