# SaaS Work Agent 本地部署
KROSS_PORT=8787
KROSS_POSTGRES_PASSWORD=
# 用于加密组织模型 API Key 和 SSO Client Secret 的主密钥，本地由 start-cloud.sh 自动生成
KROSS_CREDENTIAL_MASTER_KEY=
# 1 仅用于跳过登录的开发/冒烟测试。默认走账号密码；企业 SSO 在管理中心配置，不走环境变量。
KROSS_DEV_IDENTITY=0
KROSS_ORCHESTRATOR_MANAGER_ID=kross-saas
# 单机可保持 http://kross-server:8787。集群必须改成节点和 Worker 容器都能访问的地址。
KROSS_PUBLIC_BASE_URL=http://kross-server:8787

KROSS_S3_PORT=9000
KROSS_S3_ACCESS_KEY=kross
KROSS_S3_SECRET_KEY=
KROSS_S3_BUCKET=kross
KROSS_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000

# 工作区存储：local=本机 Docker volume（默认）；juicefs=由 juicedata/mount 挂到宿主机
KROSS_WORKER_STORAGE=local
KROSS_JUICEFS_MOUNT=/var/lib/kross/jfs
# 运行时：local=控制面本机 Docker（默认）；cluster=由 kross-node 跨机起容器
# 集群：docker compose -f docker-compose.yml -f docker-compose.juicefs.yml -f docker-compose.cluster.yml up -d
KROSS_WORKER_RUNTIME=local
KROSS_NODE_TOKEN=
KROSS_NODE_ID=node-1
# 额外 Worker 机（docker-compose.node.yml）填写控制面主机名或 IP
KROSS_CONTROL_PLANE_URL=
KROSS_JUICEFS_META_HOST=

# LLM example (choose one provider)
AGENT_LLM_PROVIDER=openai
AGENT_LLM_MODEL=gpt-5.6-sol
OPENAI_API_KEY=
OPENAI_BASE_URL=
