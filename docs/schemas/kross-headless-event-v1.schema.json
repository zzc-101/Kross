{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zzc-101/Kross/blob/main/docs/schemas/kross-headless-event-v1.schema.json",
  "title": "Kross Headless Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "timestamp",
    "runId",
    "sessionId",
    "sequence",
    "data"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "type": {
      "enum": [
        "run.started",
        "turn.started",
        "tools.started",
        "text.delta",
        "thinking.delta",
        "approval.required",
        "run.completed",
        "error"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.started"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "permission", "cwd"],
            "properties": {
              "mode": {
                "enum": ["auto", "plan", "conductor"]
              },
              "permission": {
                "enum": ["default", "classifier", "auto"]
              },
              "cwd": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "turn.started"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["iteration"],
            "properties": {
              "iteration": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tools.started"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["iteration", "count"],
            "properties": {
              "iteration": {
                "type": "integer",
                "minimum": 1
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": ["text.delta", "thinking.delta"]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "approval.required"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["toolCallId", "toolName", "risk"],
            "properties": {
              "toolCallId": {
                "type": "string",
                "minLength": 1
              },
              "toolName": {
                "type": "string",
                "minLength": 1
              },
              "risk": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.completed"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "summary",
              "verificationStatus",
              "changedFiles",
              "risks"
            ],
            "properties": {
              "status": {
                "enum": ["completed", "failed", "cancelled"]
              },
              "summary": {
                "type": "string"
              },
              "verificationStatus": {
                "enum": ["passed", "failed", "not-run", "not-needed"]
              },
              "changedFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "risks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["category", "message", "retryable"],
            "properties": {
              "category": {
                "enum": [
                  "usage",
                  "configuration",
                  "approval-required",
                  "runtime",
                  "verification",
                  "interrupted"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  ]
}
